{
  "name": "scriptographer-core",
  "private": true,
  "type": "module",
  "description": "What Scriptographer's scripts see, written in JavaScript, shared by its hosts (VectorCraft, Glyphs): bundled into dist/, which their runtimes load",
  "scripts": {
    "build": "node build.js",
    "check": "node build.js --check && pnpm run prettier",
    "prettier": "prettier 'src/**/*.js' '*.js' --check",
    "prettier:fix": "prettier 'src/**/*.js' '*.js' --write"
  },
  "engines": {
    "node": ">= 24.0.0"
  },
  "packageManager": "pnpm@12.9.0",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "~3.9.10",
    "prettier-plugin-penere": "^0.4.0"
  }
}
